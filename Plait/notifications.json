// Available "type" values (triggers color & icon in PlaiT):
// - "welcome" : Evergreen (always shown to new users, never expires)
// - "tip"     : Evergreen (always shown to new users, never expires)
// - "update"  : Evergreen (always shown to new users, never expires)
// - "info"    : Expires after 24h unless "sticky": true
// - "warning" : Expires after 24h unless "sticky": true
// - "error"   : Expires after 24h unless "sticky": true
// - "success" : Expires after 24h unless "sticky": true
//
// Multi-language support (en / fr / ar):
// "title", "message", and "action_label" can be objects with { "en": "...", "fr": "...", "ar": "..." }
// (or plain strings for single-language).
//
// Optional fields:
// - "version"      : Target version for "update" notifications (e.g. "1.0.1")
// - "action_label" : Button label text (supports { "en", "fr", "ar" })
// - "url"          : Link opened or APK/release URL downloaded when the button is tapped
// Date format: "yy/MM/dd/HH/mm" (e.g. "26/11/27/08/00")
